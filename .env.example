# Copy to .env and replace every value before any shared or production deployment.
# The LiveKit key pair below matches infrastructure/livekit/livekit.yaml for local Docker only.

POSTGRES_DB=omnicall
POSTGRES_USER=omnicall
POSTGRES_PASSWORD=omnicall
DATABASE_URL=jdbc:postgresql://localhost:5432/omnicall
DATABASE_USER=omnicall
DATABASE_PASSWORD=omnicall

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-in-production-use-a-long-random-string
INTERNAL_API_TOKEN=dev-internal-token

SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LIVEKIT_HOST=http://localhost:7880
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

AI_SERVICE_URL=http://localhost:8090
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Android emulator reaches the host machine at 10.0.2.2.
# A physical phone needs this computer's LAN address.
API_BASE=http://10.0.2.2:8080
WS_BASE=ws://10.0.2.2:8080/ws
